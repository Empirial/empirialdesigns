# Server-only secrets. Populate these through the deployment environment or local
# untracked functions/.env file. Never commit real values.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GITHUB_TOKEN=

# Unused for chat/generation since the pipeline switched from OpenRouter to
# DeepSeek directly (see functions/agents/shared.js) — the free OpenRouter
# model's 50 requests/day account-wide cap made it unworkable beyond solo
# testing.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# --- IMAGE GENERATION (functions/integrations/openrouter/imageGeneration.js) ---
# Deliberately left blank until there's a funded budget — every image-gen
# code path checks for this and returns a friendly "not enabled yet" error
# when it's unset, rather than failing generation. Set it to turn images on;
# no other code change is needed.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
OPENROUTER_APP_URL=https://empirialdesigns.web.app
OPENROUTER_APP_NAME=Empirial AI Website Builder

# --- VERCEL (functions/integrations/vercel/) ---
# Also covers domains.js (connectDomain/getDomainStatus/disconnectDomain) —
# no separate credential needed, same VERCEL_TOKEN. Personal-account token:
# leave VERCEL_TEAM_ID blank. If generated repos ever move to a GitHub org,
# check your Vercel plan's Git-org restrictions before setting
# VERCEL_TEAM_ID (see docs — Hobby plan limits this).
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PRODUCTION_BRANCH=main

# --- GOOGLE SEARCH CONSOLE + BUSINESS PROFILE (functions/integrations/google/) ---
# From a Google Cloud project with the Search Console API + Site
# Verification API enabled, and an OAuth consent screen configured.
# Business Profile (businessProfile.js) reuses this same OAuth client via
# oauth.js's 'business.manage' scope, but is NOT self-serve like the other
# two — Google must separately approve the project for Business Profile API
# access (https://developers.google.com/my-business/content/prereqs) before
# any businessProfile* Cloud Function will succeed. Anyone who connected
# Google before that scope was added needs to reconnect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://us-central1-empirialdesigns.cloudfunctions.net/googleCallback

# --- GOOGLE PLACES (functions/integrations/google/places.js) ---
# API-key auth, not OAuth — a Cloud project with the Places API (New)
# enabled. Powers findGooglePlace/getGoogleReviews, which feed real reviews
# into agents/coders/base.js's applyRealReviews (replaces invented
# testimonials once a business has >= 3 real reviews linked).
GOOGLE_PLACES_API_KEY=

# --- GOOGLE PAGESPEED INSIGHTS (functions/integrations/google/pagespeed.js) ---
# Optional — works keyless at Google's shared low quota; set this to raise
# it if pageSpeedAudit starts getting rate-limited.
GOOGLE_PAGESPEED_API_KEY=

# --- UPTIME MONITORING (functions/integrations/uptime/uptimeRobot.js) ---
# From an UptimeRobot account (Main API Key, not a Monitor-Specific key —
# needs newMonitor/getMonitors/deleteMonitor access).
UPTIMEROBOT_API_KEY=

# --- APPLICATION ---
# Where googleCallback redirects back to after a Google connection.
APP_URL=https://empirialdesigns.web.app
